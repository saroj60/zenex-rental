# ============================================================
# Zenex Travel - Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to git (it's in .gitignore).

# ---- PRODUCTION ONLY ----
# The full URL of your Render.com backend (no trailing slash)
# Example: https://zenex-backend.onrender.com
VITE_API_URL=https://your-backend-name.onrender.com

# ---- LOCAL DEV ----
# Leave VITE_API_URL empty (comment it out) when developing locally.
# Vite's proxy in vite.config.js handles /api/* → localhost:5000 automatically.
# VITE_API_URL=
