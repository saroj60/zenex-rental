# ============================================================
# Hostinger MySQL Database Configuration
# ============================================================
# When deploying to Hostinger:
# 1. Create a database in Hostinger hPanel -> Databases -> MySQL Databases
# 2. Copy this file to .env in your backend folder and fill in the values below:

DB_HOST=localhost
DB_PORT=3306
DB_USER=u123456789_zenex
DB_PASSWORD=your_mysql_password
DB_NAME=u123456789_zenex

# Server Port (default 5000)
PORT=5000

# Booking Notifications Mail Recipient
MAIL_TO=info@zenextravels.com

# SMTP Configuration for Direct Server Email Dispatch
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=info@zenextravels.com
# SMTP_PASS=your_email_password
# SMTP_FROM="Zenex Travels Booking" <info@zenextravels.com>
